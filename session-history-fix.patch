+/// モデル出力からGemmaテンプレートタグを除去する
+/// セッション保存前に呼ぶことで、次ターンのプロンプトへのタグ混入を防ぐ
+fn strip_template_tags(s: &str) -> String {
+    // <end_of_turn>以降は不要なので切り捨て
+    let s = if let Some(idx) = s.find("<end_of_turn>") {
+        &s[..idx]
+    } else {
+        s
+    };
+    // <start_of_turn>xxx
+ も除去
+    let mut result = String::new();
+    let mut rest = s;
+    while let Some(idx) = rest.find("<start_of_turn>") {
+        result.push_str(&rest[..idx]);
+        if let Some(nl) = rest[idx..].find(n) {
+            rest = &rest[idx + nl + 1..];
+        } else {
+            rest = "";
+            break;
+        }
+    }
+    result.push_str(rest);
+    result.trim().to_string()
+}
